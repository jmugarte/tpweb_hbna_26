{
  "version": 2,
  "builds": [
    { "src": "backend_portal/wsgi.py", "use": "@vercel/python" },
    {
      "src": "client_portal/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend_portal/wsgi.py" },
    { "src": "/admin/(.*)", "dest": "backend_portal/wsgi.py" },
    { "src": "/static/(.*)", "dest": "backend_portal/wsgi.py" },
    { "src": "/assets/(.*)", "dest": "client_portal/dist/assets/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "client_portal/dist/index.html" }
  ]
}