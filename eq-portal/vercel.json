{
  "builds": [
    {
      "src": "backend_portal/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "client_portal/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "backend_portal/wsgi.py"
    },
    {
      "src": "^/static/(.*)",
      "dest": "backend_portal/wsgi.py"
    },
    {
      "src": "^/(assets/.*|.*\\..*)$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}